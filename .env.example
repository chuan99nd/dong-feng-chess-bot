# Copy to .env (gitignored) and fill in. Used by deploy/commit-model.yml to push
# trained models to github.com over HTTPS — separate from the company GitHub
# Enterprise / gh CLI token.
#
# Create a fine-grained PAT scoped to ONLY this repo with Contents: Read+Write:
#   https://github.com/settings/tokens?type=beta
GITHUB_PAT=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Hugging Face write token — used by deploy/push-model.yml to upload checkpoints
# (models live on the HF Hub, not git). Create one at:
#   https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
